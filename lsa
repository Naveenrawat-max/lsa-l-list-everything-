#!/bin/bash

list_contents() {
    local dir="$1"
    local indent="$2"

    local items=("$dir"/*)
    for item in "${items[@]}"; do
        # Skip if glob didn't match anything (e.g., empty directory)
        [ -e "$item" ] || [ -L "$item" ] || continue

        local base="${item##*/}"

        local color_code=""
        if [ -d "$item" ]; then
            # Directory (blue)
            color_code="\e[1;34m"
        elif [ -x "$item" ]; then
            # Executable (green)
            color_code="\e[1;32m"
        fi

        if [ "$count" -eq "$total" ]; then
            # Last item
            printf "%s└── ${COLOR}%s %s${RESET}\n" "$indent" "$ICON" "$base"
            if [ -d "$item" ]; then
                list_contents "$item" "$indent    "
            fi
        else
            # Not last item
            printf "%s├── ${COLOR}%s %s${RESET}\n" "$indent" "$ICON" "$base"
            if [ -d "$item" ]; then
                list_contents "$item" "$indent│   "
            fi
        fi
    done
}

target_dir="${1:-$(pwd)}"

if [ ! -d "$target_dir" ]; then
    echo "Error: Directory '$target_dir' does not exist."
    exit 1
fi

target_dir=$(cd "$target_dir" >/dev/null 2>&1 && pwd)
if [ -z "$target_dir" ]; then
    echo "Error: Cannot access directory"
    exit 1
fi

printf "\e[1;32m%s\e[0m\n" "$target_dir"

printf "Subdirectories and contents:\n"
shopt -s nullglob
list_contents "$target_dir" ""
